## styles.css

````css
:root {
--primary: #7a3b2e;
--primary-dark: #5d291f;
--gold: #d7a94f;
--cream: #f6f0ea;
--charcoal: #1f1f1f;
--muted: #5d5d5d;
--white: #ffffff;
--shadow: rgba(23, 18, 16, 0.15);
}

* {
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {
margin: 0;
font-family: "Inter", sans-serif;
color: var(--charcoal);
background: var(--white);
line-height: 1.6;
}

img {
width: 100%;
display: block;
}

a {
text-decoration: none;
color: inherit;
}

.container {
width: min(1120px, 90%);
margin: 0 auto;
}

.site-header {
position: sticky;
top: 0;
z-index: 10;
background: rgba(26, 22, 19, 0.8);
backdrop-filter: blur(8px);
border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.nav {
display: flex;
align-items: center;
justify-content: space-between;
min-height: 76px;
}

.brand {
color: var(--white);
font-weight: 700;
font-size: 1.5rem;
display: flex;
align-items: center;
gap: 0.55rem;
}

.brand-mark {
display: inline-flex;
align-items: center;
justify-content: center;
width: 32px;
height: 32px;
border-radius: 50%;
background: var(--gold);
color: var(--primary-dark);
font-weight: 800;
}

.nav-links {
display: flex;
gap: 1.4rem;
color: rgba(255, 255, 255, 0.85);
font-size: 0.95rem;
font-weight: 500;
}

.nav-links a:hover {
color: var(--gold);
}

.hero {
position: relative;
min-height: 680px;
display: grid;
place-items: center;
background:
url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1800&q=80")
center/cover no-repeat;
}

.hero-overlay {
position: absolute;
inset: 0;
background: linear-gradient(90deg, rgba(17, 14, 12, 0.8), rgba(17, 14, 12, 0.25));
}

.hero-content {
position: relative;
z-index: 1;
color: var(--white);
width: min(680px, 90%);
padding: 3rem 0;
}

.eyebrow {
font-size: 0.8rem;
letter-spacing: 0.14em;
text-transform: uppercase;
font-weight: 700;
color: var(--gold);
margin-bottom: 1rem;
}

.eyebrow.dark {
color: var(--primary);
}

.hero h1,
.section-heading h2,
.contact-card h2 {
font-family: "Playfair Display", serif;
margin: 0 0 1rem;
line-height: 1.2;
}

.hero h1 {
font-size: clamp(2.8rem, 5vw, 5rem);
max-width: 620px;
}

.hero p {
font-size: 1.1rem;
max-width: 600px;
color: rgba(255, 255, 255, 0.87);
}

.hero-actions {
display: flex;
flex-wrap: wrap;
gap: 1rem;
margin-top: 2rem;
}

.btn {
display: inline-block;
border-radius: 999px;
padding: 0.9rem 1.5rem;
font-weight: 700;
transition: 0.25s ease;
}

.btn-primary {
background: var(--gold);
color: var(--primary-dark);
}

.btn-primary:hover {
background: #e0b464;
}

.btn-secondary {
border: 1px solid rgba(255, 255, 255, 0.4);
background: rgba(255, 255, 255, 0.08);
color: var(--white);
}

.btn-secondary:hover {
background: rgba(255, 255, 255, 0.18);
}

section {
padding: 5rem 0;
}

.section-heading {
margin-bottom: 2.5rem;
}

.section-heading.center {
text-align: center;
}

.section-heading h2 {
font-size: clamp(2.2rem, 4vw, 3.2rem);
color: var(--charcoal);
}

.about-grid {
display: grid;
grid-template-columns: 1.4fr 1fr;
gap: 2rem;
align-items: center;
}

.about-copy p {
font-size: 1.05rem;
color: var(--muted);
margin-bottom: 1rem;
}

.about-card {
background: var(--cream);
padding: 2rem;
border-radius: 1.25rem;
box-shadow: 0 12px 28px var(--shadow);
}

.about-card h3 {
margin-top: 0;
font-size: 1.5rem;
color: var(--primary-dark);
}

.about-card ul {
margin: 0;
padding-left: 1.25rem;
color: var(--charcoal);
}

.bar-section {
background: linear-gradient(180deg, #fffaf7, #f7efe9);
}

.feature-grid {
display: grid;
grid-template-columns: repeat(3, minmax(0, 1fr));
gap: 2rem;
}

.feature-card {
background: var(--white);
overflow: hidden;
border-radius: 20px;
box-shadow: 0 14px 32px var(--shadow);
}

.feature-card img {
height: 260px;
object-fit: cover;
}

.card-body {
padding: 1.5rem;
}

.card-body h3 {
margin: 0 0 0.5rem;
font-size: 1.4rem;
color: var(--primary-dark);
}

.card-body p {
margin: 0;
color: var(--muted);
}

.room-grid {
display: grid;
grid-template-columns: repeat(3, minmax(0, 1fr));
gap: 2rem;
}

.room-card {
background: var(--white);
border-radius: 20px;
overflow: hidden;
box-shadow: 0 12px 28px rgba(31, 31, 31, 0.08);
}

.room-card img {
height: 260px;
object-fit: cover;
}

.room-info {
padding: 1.5rem;
}

.room-info h3 {
margin-top: 0;
margin-bottom: 0.75rem;
font-size: 1.5rem;
color: var(--primary-dark);
}

.room-info p {
margin: 0 0 1rem;
color: var(--muted);
}

.room-info span {
display: inline-block;
font-weight: 700;
color: var(--primary);
}

.gallery-section {
background: #fbf4ef;
}

.gallery-grid {
display: grid;
grid-template-columns: repeat(4, minmax(0, 1fr));
gap: 1rem;
}

.gallery-grid img {
height: 250px;
object-fit: cover;
border-radius: 18px;
transition: transform 0.25s ease;
}

.gallery-grid img:hover {
transform: scale(1.02);
}

.contact-card {
display: flex;
align-items: center;
justify-content: space-between;
gap: 2rem;
padding: 2rem 2.5rem;
background: linear-gradient(135deg, var(--primary-dark), var(--primary));
color: var(--white);
border-radius: 24px;
box-shadow: 0 16px 40px rgba(93, 41, 31, 0.22);
}

.contact-details p {
margin: 0.35rem 0;
color: rgba(255, 255, 255, 0.9);
}

.site-footer {
padding: 1.25rem 1rem;
text-align: center;
background: #1a1412;
color: rgba(255, 255, 255, 0.8);
}

@media (max-width: 900px) {
.about-grid,
.feature-grid,
.room-grid,
.gallery-grid,
.contact-card {
grid-template-columns: 1fr;
display: grid;
}

.contact-card {
justify-content: flex-start;
}

.nav {
flex-direction: column;
justify-content: center;
gap: 1rem;
padding: 1rem 0;
}

.nav-links {
flex-wrap: wrap;
justify-content: center;
}
}

@media (max-width: 600px) {
.hero {
min-height: 560px;
}

.hero-content {
text-align: center;
}

.hero-actions {
justify-content: center;
}

.gallery-grid {
grid-template-columns: 1fr 1fr;
}
}
````

